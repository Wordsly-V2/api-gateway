# ── api-gateway ───────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Vars marked (required) are validated at boot
# (src/config/validate-env.ts) — the service will refuse to start without them.

# HTTP port the gateway listens on.
PORT=3000

# Comma-separated list of allowed CORS origins (e.g. http://localhost:4000).
CORS_ENABLED_ORIGINS=http://localhost:4000

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# (required) JWT verification key (RSA public key or shared secret).
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Refresh token delivery: 'cookie' (default) or 'body'.
REFRESH_TOKEN_DELIVERY=cookie
REFRESH_TOKEN_COOKIE_HTTP_ONLY=true
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_MAX_AGE=30d
REFRESH_TOKEN_COOKIE_PATH=/auth

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:4000/auth/redirect

# ── Downstream services ───────────────────────────────────────────────────────
# Hosts default to localhost if unset. Internal tokens are (required) and must
# match each downstream service's INTERNAL_SERVICE_TO_SERVICE_TOKEN.
AUTH_SERVICE_HOST=http://localhost:3001
AUTH_SERVICE_INTERNAL_TOKEN=
AUTH_SERVICE_HTTP_TIMEOUT=

VOCABULARY_SERVICE_HOST=http://localhost:3002
VOCABULARY_SERVICE_INTERNAL_TOKEN=
VOCABULARY_SERVICE_HTTP_TIMEOUT=

LEARNING_SERVICE_HOST=http://localhost:3003
LEARNING_SERVICE_INTERNAL_TOKEN=
LEARNING_SERVICE_HTTP_TIMEOUT=

# ── Kafka (optional; leave empty to disable) ──────────────────────────────────
KAFKA_BROKERS=
KAFKA_CA=
KAFKA_CERT=
KAFKA_KEY=
