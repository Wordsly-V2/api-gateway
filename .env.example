# ── api-gateway ───────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Vars marked (required) are validated at boot
# (src/config/validate-env.ts) — the service will refuse to start without them.
#
# The gateway is a reverse proxy and deliberately holds no secrets. It does not
# verify tokens (each service verifies against auth-service's published key set)
# and does not authenticate to its peers (it forwards the caller's own
# credentials and strips any internal header a client supplies). If you are
# looking for JWT keys, Google OAuth or the internal service token, they live in
# auth-service's .env now.

# HTTP port the gateway listens on.
PORT=3000

# (required) Comma-separated list of allowed CORS origins. Required rather than
# optional because an empty value used to make the gateway skip enableCors
# altogether, silently disabling CORS instead of failing.
CORS_ENABLED_ORIGINS=http://localhost:4000

# ── Where to send traffic ─────────────────────────────────────────────────────
# (required) docker compose overrides these with compose-network hostnames.
AUTH_SERVICE_HOST=http://localhost:3001
VOCABULARY_SERVICE_HOST=http://localhost:3002
LEARNING_SERVICE_HOST=http://localhost:3003

# Per-service request timeouts in ms (default 15000). A hung downstream service
# must not hold a connection open forever.
AUTH_SERVICE_HTTP_TIMEOUT=
VOCABULARY_SERVICE_HTTP_TIMEOUT=
LEARNING_SERVICE_HTTP_TIMEOUT=
